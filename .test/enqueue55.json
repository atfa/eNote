{
"hdr": [
"\tif r.ID != \"\" && store.get(r.ID) != nil {",
"\t\treturn reingest(r)",
"\t}",
"\tn := &Note{",
"\t\tID:        newID(),",
"\t\tCreatedAt: time.Now(),",
"\t\tUpdatedAt: time.Now(),",
"\t\tStatus:    stQueued,",
"\t\tSource:    r.Source,",
"\t}",
"\tif n.Source == \"\" {",
"\t\tn.Source = \"manual-text\"",
"\t}"
],
"image": [
"\t\tif r.OCRError != \"\" {",
"\t\t\tn.Status = stError",
"\t\t\tn.Error = r.OCRError",
"\t\t}",
"\t\tn.ImagePath = r.Path",
"\t\tn.ImageName = firstNonEmpty(r.Name, filepath.Base(r.Path))",
"\t\tif r.Path != \"\" {",
"\t\t\tattachTo(n, attachmentFor(n.ID, r.Path, n.ImageName, r.MIME, r.Source, n.CreatedAt))",
"\t\t}",
"\t\tn.OCRText = strings.TrimSpace(r.OCR)",
"\t\tn.OCRMs = r.OCRMs",
"\t\tn.RawText = n.OCRText",
"\t\tn.Content = n.OCRText",
"\t\tif n.Status != stError && n.OCRText == \"\" {",
"\t\t\tn.Status = stRaw",
"\t\t\tn.Error = \"图片里没有识别到文字\"",
"\t\t}"
],
"imgcmt": [
"\t\t// 多张截图合成一条笔记（P11 合并模式）：附件按时间顺序全部挂上，",
"\t\t// OCR 文本拼接后只调一次 LLM —— 10 张图 = 1 次调用，不是 10 次。"
],
"images": [
"\t\tif len(r.Images) == 0 {",
"\t\t\treturn enqueueResult{Kind: r.Kind, Error: \"没有图片\"}",
"\t\t}",
"\t\tvar parts []string",
"\t\tocrErr := \"\"",
"\t\tfor _, im := range r.Images {",
"\t\t\tname := firstNonEmpty(im.Name, filepath.Base(im.Path))",
"\t\t\tattachTo(n, attachmentFor(n.ID, im.Path, name, im.MIME, n.Source, n.CreatedAt))",
"\t\t\tif n.ImagePath == \"\" {",
"\t\t\t\tn.ImagePath, n.ImageName = im.Path, name",
"\t\t\t}",
"\t\t\tif t := strings.TrimSpace(im.OCR); t != \"\" {",
"\t\t\t\tparts = append(parts, t)",
"\t\t\t}",
"\t\t\tif im.Err != \"\" && ocrErr == \"\" {",
"\t\t\t\tocrErr = im.Err",
"\t\t\t}",
"\t\t\tn.OCRMs += im.Ms",
"\t\t}",
"\t\tn.OCRText = strings.Join(parts, \"\\n\\n---\\n\\n\")",
"\t\tn.RawText = n.OCRText",
"\t\tn.Content = n.OCRText",
"\t\tn.Title = fmt.Sprintf(\"截图 %d 张 · %s\", len(r.Images), time.Now().Format(\"01-02 15:04\"))",
"\t\tswitch {",
"\t\tcase ocrErr != \"\":",
"\t\t\tn.Status, n.Error = stError, ocrErr",
"\t\tcase n.OCRText == \"\":",
"\t\t\tn.Status, n.Error = stRaw, \"图片里没有识别到文字\"",
"\t\tcase r.Raw:",
"\t\t\tn.Status, n.Error = stRaw, \"原样保存，未做 AI 解析\"",
"\t\t}"
],
"filecmt": [
"\t\t// a document (pdf, docx, txt, ...) shared or picked: stored, not sent to the LLM"
],
"file": [
"\t\tif n.Source == \"manual-text\" {",
"\t\t\tn.Source = \"manual-file\"",
"\t\t}",
"\t\tif r.FileError != \"\" {",
"\t\t\tn.Status = stError",
"\t\t\tn.Error = r.FileError",
"\t\t\tn.Content = \"文件接收失败：\" + r.FileError",
"\t\t\tn.Title = firstNonEmpty(r.Name, \"文件\")",
"\t\t\tbreak",
"\t\t}",
"\t\tif r.Path == \"\" {",
"\t\t\treturn enqueueResult{Kind: r.Kind, Error: \"文件路径为空\"}",
"\t\t}",
"\t\tn.Title = firstNonEmpty(r.Name, filepath.Base(r.Path))",
"\t\tn.Content = \"已保存附件：\" + n.Title",
"\t\tn.RawText = \"\"",
"\t\tn.Status = stRaw",
"\t\tn.Error = \"文件已保存，未做 AI 解析\"",
"\t\tattachTo(n, attachmentFor(n.ID, r.Path, n.Title, r.MIME, n.Source, n.CreatedAt))"
],
"text": [
"\t\tn.RawText = strings.TrimSpace(r.Text)",
"\t\tn.Content = n.RawText",
"\t\tn.Title = strings.TrimSpace(r.Subject)",
"\t\tif n.RawText == \"\" {",
"\t\t\treturn enqueueResult{Kind: r.Kind, Error: \"内容为空\"}",
"\t\t}",
"\t\tif r.Raw {",
"\t\t\t// 原样存为笔记：不调 LLM，直接落库",
"\t\t\tn.Status = stRaw",
"\t\t\tn.Error = \"原样保存，未做 AI 解析\"",
"\t\t}",
"\t}"
],
"tail": [
"\tstore.add(n)",
"\tlogf(\"enqueue %s kind=%s source=%s len=%d ocrMs=%d status=%s\",",
"\t\tn.ID, r.Kind, r.Source, len(n.RawText), n.OCRMs, n.Status)",
"\tif n.Status == stQueued {",
"\t\tjobs <- n.ID",
"\t}",
"\treturn enqueueResult{ID: n.ID, Kind: r.Kind}"
]
}