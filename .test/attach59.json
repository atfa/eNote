{
"hdr": [
"\tq = strings.ToLower(strings.TrimSpace(q))",
"\tlimit = clampLimit(limit, 500, 2000)",
"\tres := attachRes{OK: true}"
],
"loop": [
"\tfor _, n := range store.snapshot() {",
"\t\tif noteID != \"\" && n.ID != noteID {",
"\t\t\tcontinue",
"\t\t}",
"\t\tres.Scanned++",
"\t\tfor _, a := range n.Attachments {",
"\t\t\tit := attachItem{Attachment: a, NoteTitle: n.Title, Kind: kindOfMime(a.MIME)}",
"\t\t\tif it.NoteTitle == \"\" {",
"\t\t\t\tit.NoteTitle = \"(未命名笔记)\"",
"\t\t\t}",
"\t\t\tit.NoteAt = n.CreatedAt.Format(\"2006-01-02 15:04\")",
"\t\t\tif a.Path == \"\" {",
"\t\t\t\tit.Missing = true",
"\t\t\t} else if _, err := os.Stat(a.Path); err != nil {",
"\t\t\t\tit.Missing = true",
"\t\t\t}",
"\t\t\tswitch mime {",
"\t\t\tcase \"\", \"all\":",
"\t\t\t\t// no filter",
"\t\t\tdefault:",
"\t\t\t\tif strings.Contains(mime, \"/\") {",
"\t\t\t\t\tif !strings.HasPrefix(strings.ToLower(a.MIME), strings.ToLower(mime)) {",
"\t\t\t\t\t\tcontinue",
"\t\t\t\t\t}",
"\t\t\t\t} else if it.Kind != mime {",
"\t\t\t\t\tcontinue",
"\t\t\t\t}",
"\t\t\t}",
"\t\t\tif q != \"\" {",
"\t\t\t\tblob := strings.ToLower(a.Name + \"\\n\" + a.MIME + \"\\n\" + it.NoteTitle)",
"\t\t\t\tif !strings.Contains(blob, q) {",
"\t\t\t\t\tcontinue",
"\t\t\t\t}",
"\t\t\t}",
"\t\t\tres.Items = append(res.Items, it)",
"\t\t\tres.Bytes += a.Size",
"\t\t}",
"\t}"
],
"build": [
"\t\t\tit := attachItem{Attachment: a, NoteTitle: n.Title, Kind: kindOfMime(a.MIME)}",
"\t\t\tif it.NoteTitle == \"\" {",
"\t\t\t\tit.NoteTitle = \"(未命名笔记)\"",
"\t\t\t}",
"\t\t\tit.NoteAt = n.CreatedAt.Format(\"2006-01-02 15:04\")",
"\t\t\tif a.Path == \"\" {",
"\t\t\t\tit.Missing = true",
"\t\t\t} else if _, err := os.Stat(a.Path); err != nil {",
"\t\t\t\tit.Missing = true",
"\t\t\t}"
],
"filt": [
"\t\t\tswitch mime {",
"\t\t\tcase \"\", \"all\":",
"\t\t\t\t// no filter",
"\t\t\tdefault:",
"\t\t\t\tif strings.Contains(mime, \"/\") {",
"\t\t\t\t\tif !strings.HasPrefix(strings.ToLower(a.MIME), strings.ToLower(mime)) {",
"\t\t\t\t\t\tcontinue",
"\t\t\t\t\t}",
"\t\t\t\t} else if it.Kind != mime {",
"\t\t\t\t\tcontinue",
"\t\t\t\t}",
"\t\t\t}",
"\t\t\tif q != \"\" {",
"\t\t\t\tblob := strings.ToLower(a.Name + \"\\n\" + a.MIME + \"\\n\" + it.NoteTitle)",
"\t\t\t\tif !strings.Contains(blob, q) {",
"\t\t\t\t\tcontinue",
"\t\t\t\t}",
"\t\t\t}"
],
"tail": [
"\tres.Total = len(res.Items)",
"\t// files/missing describe the *filtered* list, so a search cannot make missing negative",
"\tfor _, it := range res.Items {",
"\t\tif it.Missing {",
"\t\t\tres.Missing++",
"\t\t}",
"\t}",
"\tres.Files = res.Total - res.Missing",
"\tsortAttachments(res.Items, sortKey, dir)",
"\tif res.Total > limit {",
"\t\tres.Items = res.Items[:limit]",
"\t}",
"\tres.Dirs = attachmentDirs()",
"\tres.DiskFiles = countDiskFiles()",
"\treturn res"
]
}