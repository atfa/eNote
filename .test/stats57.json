{
"skel": [
"\tres := statsRes{OK: true,",
"\t\tNotes:   map[string]int{},",
"\t\tTodos:   map[string]int{},",
"\t\tAttach:  map[string]any{\"byKind\": map[string]int{}},",
"\t\tAI:      map[string]any{},",
"\t\tSources: map[string]int{},",
"\t\tDays:    lastDays(7)}",
"\tfor _, k := range []string{\"total\", \"done\", \"raw\", \"error\", \"queued\", \"parsing\"} {",
"\t\tres.Notes[k] = 0",
"\t}",
"\tfor _, k := range []string{\"total\", \"open\", \"done\", \"overdue\", \"dueToday\", \"high\", \"withDue\"} {",
"\t\tres.Todos[k] = 0",
"\t}"
],
"acc": [
"\tdayIdx := map[string]int{}",
"\tfor i, d := range res.Days {",
"\t\tdayIdx[d.Day] = i",
"\t}",
"\ttags := map[string]int{}",
"\ttoday := time.Now().Format(\"2006-01-02\")",
"\tnow := nowStamp()"
],
"loop": [
"\tfor _, n := range store.snapshot() {",
"\t\tres.Notes[\"total\"]++",
"\t\tst := n.Status",
"\t\tif st == \"\" {",
"\t\t\tst = stDone",
"\t\t}",
"\t\tres.Notes[st]++",
"\t\tres.Sources[firstNonEmpty(n.Source, \"unknown\")]++",
"\t\tfor _, t := range n.Tags {",
"\t\t\tif t = trimTag(t); t != \"\" {",
"\t\t\t\ttags[t]++",
"\t\t\t}",
"\t\t}",
"\t\tday := n.CreatedAt.Format(\"2006-01-02\")",
"\t\tif i, ok := dayIdx[day]; ok {",
"\t\t\tres.Days[i].Notes++",
"\t\t\tres.Days[i].Todos += len(n.Todos)",
"\t\t}",
"\t\tfor _, t := range n.Todos {",
"\t\t\tres.Todos[\"total\"]++",
"\t\t\tif t.Priority == \"high\" {",
"\t\t\t\tres.Todos[\"high\"]++",
"\t\t\t}",
"\t\t\tif t.Due != \"\" {",
"\t\t\t\tres.Todos[\"withDue\"]++",
"\t\t\t}",
"\t\t\tif t.Done {",
"\t\t\t\tres.Todos[\"done\"]++",
"\t\t\t\tif i, ok := dayIdx[dayOf(t.DoneAt)]; ok {",
"\t\t\t\t\tres.Days[i].Done++",
"\t\t\t\t}",
"\t\t\t\tcontinue",
"\t\t\t}",
"\t\t\tres.Todos[\"open\"]++",
"\t\t\tif t.Due != \"\" && t.Due < now {",
"\t\t\t\tres.Todos[\"overdue\"]++",
"\t\t\t}",
"\t\t\tif len(t.Due) >= 10 && t.Due[:10] == today {",
"\t\t\t\tres.Todos[\"dueToday\"]++",
"\t\t\t}",
"\t\t}",
"\t\tfor _, a := range n.Attachments {",
"\t\t\tres.Attach[\"count\"] = iv(res.Attach[\"count\"]) + 1",
"\t\t\tres.Attach[\"bytes\"] = i64v(res.Attach[\"bytes\"]) + a.Size",
"\t\t\tif fileSize(a.Path) == 0 {",
"\t\t\t\tres.Attach[\"missing\"] = iv(res.Attach[\"missing\"]) + 1",
"\t\t\t}",
"\t\t\tbyk := res.Attach[\"byKind\"].(map[string]int)",
"\t\t\tbyk[kindOfMime(a.MIME)]++",
"\t\t}",
"\t}"
],
"fin": [
"\tres.Tags = topTags(tags, 8)",
"\tres.Attach[\"count\"] = iv(res.Attach[\"count\"])",
"\tres.AI = aiStats()",
"\tres.Bytes = dataBytes()",
"\treturn res"
]
}