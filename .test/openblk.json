{"open": ["function openNote(id){", "  if(!id) return;", "  setTabTo('notes'); open[id]=true; setTab(true); refresh();", "  setTimeout(function(){var el=document.getElementById('n'+id);", "    if(el) el.scrollIntoView({behavior:'smooth',block:'center'});", "    else toast('这条笔记已删除');}, 300);", "}", "window.openNote = openNote; window.notifyResult = notifyResult;", "/* 通知点进来：展开这条笔记并定位到那一条待办（滚过去 + 亮一下）*/", "function openTodo(nid, tid){", "  if(!nid) return;", "  var n = (S.notes||[]).filter(function(x){return x.id===nid})[0];", "  if(n) open[nid] = true;", "  setTabTo('notes'); setTab(true); refresh();", "  openTodoFocus(nid, tid, 0);", "}", "function openTodoFocus(nid, tid, tries){", "  setTimeout(function(){", "    if(!el){", "      if(tries < 6) return openTodoFocus(nid, tid, tries+1);", "      toast('这条待办已完成或已删除'); return;", "    }", "    el.scrollIntoView({behavior:'smooth', block:'center'});", "    el.classList.add('flash');", "    setTimeout(function(){ el.classList.remove('flash') }, 2600);", "  }, 320);", "}"], "due": ["function dueMs(iso){ if(!iso) return 0; var d=new Date(iso); return isNaN(d)?0:d.getTime() }", "/* R13：把到期时间交给系统日历 / 闹钟（intent，不需要权限）*/", "function toCalendar(nid,tid,ev){", "  ev.stopPropagation();", "  var n=S.notes.filter(function(x){return x.id===nid})[0]; if(!n) return;", "  var t=(n.todos||[]).filter(function(x){return x.id===tid})[0]; if(!t||!t.due) return;", "  if(!window.Android||!Android.addToCalendar){ toast('日历只在 app 内可用'); return }", "  Android.addToCalendar(t.text, dueMs(t.due));", "}", "function toAlarm(nid,tid,ev){", "  ev.stopPropagation();", "  var n=S.notes.filter(function(x){return x.id===nid})[0]; if(!n) return;", "  var t=(n.todos||[]).filter(function(x){return x.id===tid})[0]; if(!t||!t.due) return;", "  if(!window.Android||!Android.setAlarm){ toast('闹钟只在 app 内可用'); return }", "  Android.setAlarm(dueMs(t.due), t.text);", "}"], "jump": ["function jump(id){ setTabTo('notes'); open[id]=true; setTab(true); refresh();", "  setTimeout(function(){var el=document.getElementById('n'+id);if(el)el.scrollIntoView({behavior:'smooth',block:'center'})},250); }"]}