{
"nil": [
"\tif clipStore == nil {",
"\t\treturn `{\"error\":\"clip store 未初始化\"}`",
"\t}"
],
"norm": [
"\tkind = strings.TrimSpace(kind)",
"\tif kind == \"\" {",
"\t\tkind = \"text\"",
"\t}",
"\tif kind == \"text\" {",
"\t\ttext = strings.TrimSpace(text)",
"\t\ttext = clip(text, maxClipText)",
"\t\tif text == \"\" {",
"\t\t\treturn `{\"ok\":false,\"error\":\"内容为空\"}`",
"\t\t}",
"\t} else if kind == \"image\" {",
"\t\tif path == \"\" && text == \"\" {",
"\t\t\treturn `{\"ok\":false,\"error\":\"图片为空\"}`",
"\t\t}",
"\t} else {",
"\t\treturn `{\"ok\":false,\"error\":\"未知类型 ` + kind + `\"}`",
"\t}"
],
"mid": [
"\tnow := time.Now()",
"\tsig := kind + \"\\x00\" + text + \"\\x00\" + path",
"\tlogf(\"clip add: kind=%s runes=%d app=%q path=%q\", kind, len([]rune(text)), app, path)",
"",
"\tclipStore.mu.Lock()",
"\tdefer clipStore.mu.Unlock()"
],
"ded": [
"\t// exact repeat of the newest item -> drop",
"\tif n := len(clipStore.Clips); n > 0 {",
"\t\tlast := clipStore.Clips[n-1]",
"\t\tif last.sig() == sig {",
"\t\t\tlogf(\"clip add: 与最新一条完全相同 → 丢弃（最新 %d 字）\", len([]rune(last.Text)))",
"\t\t\treturn `{\"ok\":true,\"duplicate\":true}`",
"\t\t}",
"\t\t// same source within 5s -> replace the newest",
"\t\tif last.App == app && now.Sub(last.CreatedAt) <= 5*time.Second {",
"\t\t\tlogf(\"clip add: 同来源 5s 内 → 覆盖最新一条\")",
"\t\t\tlast.Text = text",
"\t\t\tlast.Path = path",
"\t\t\tlast.Name = name",
"\t\t\tlast.MIME = mime",
"\t\t\tlast.Kind = kind",
"\t\t\tlast.CreatedAt = now",
"\t\t\tif err := clipStore.save(); err != nil {",
"\t\t\t\tlogf(\"clip add(replace): %v\", err)",
"\t\t\t}",
"\t\t\treturn `{\"ok\":true}`",
"\t\t}",
"\t}"
],
"app": [
"\tc := &Clip{",
"\t\tID:        newID(),",
"\t\tKind:      kind,",
"\t\tText:      text,",
"\t\tPath:      path,",
"\t\tName:      name,",
"\t\tMIME:      mime,",
"\t\tApp:       app,",
"\t\tCreatedAt: now,",
"\t}",
"\tclipStore.Clips = append(clipStore.Clips, c)",
"\tif err := clipStore.save(); err != nil {",
"\t\tlogf(\"clip add: %v\", err)",
"\t}",
"\treturn `{\"ok\":true,\"id\":\"` + c.ID + `\"}`"
]
}