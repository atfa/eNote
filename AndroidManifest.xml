<?xml version="1.0" encoding="utf-8"?>
<!--
  No <uses-sdk> here on purpose: minSdk/targetSdk are passed to `aapt2 link` by build.sh from
  app.env, so the two cannot drift apart.

  Permissions: INTERNET is for the LLM call (and the loopback WebView). The OCR engine is a
  local .so + model files, so images never leave the device.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.xduo.enote"
    android:versionCode="1"
    android:versionName="0.1">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- R13-B：向系统时钟设闹钟（normal 权限，装机即授予）；日历走 ACTION_INSERT，不需要权限 -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- R13-E / P6.5：自研到期提醒，全部标准 API。
         POST_NOTIFICATIONS 是 13+ 的运行时权限；SCHEDULE_EXACT_ALARM 是 31+ 的特殊权限，
         用户可以关掉，关掉后自动降级成 setAndAllowWhileIdle（可能晚几分钟，但不会丢）。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- targetSdk 33 上 SCHEDULE_EXACT_ALARM 默认不授予；USE_EXACT_ALARM 是 33+ 给
         闹钟/提醒类应用的自动授予版本，canScheduleExactAlarms() 直接为 true -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- P6.5 常驻后台：前台服务 + 一条低优先级常驻通知，是 AOSP 认可的“别冻结我”信号。
         REQUEST_IGNORE_BATTERY_OPTIMIZATIONS 只用于弹标准的电池优化豁免对话框。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".EnoteApp"
        android:label="懒得记"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:usesCleartextTraffic="true"
        android:debuggable="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- the share target: 分享 -> 懒得记 -->
        <activity
            android:name=".ShareActivity"
            android:label="懒得记"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- wider text sharing + PDF: stored as an attachment, not parsed (R4). Deliberately
                 no "*/*": 懒得记 should not show up in every share menu. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <!-- 到期闹钟的落点：只发通知，不启动界面（后台唤起 Activity 会被系统拦） -->        <receiver
            android:name=".Reminders$AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.xduo.enote.REMIND" />
            </intent-filter>
        </receiver>

        <!-- P6.5 常驻后台（可选，默认关）。targetSdk 33 上不需要 foregroundServiceType；
             START_STICKY 让进程被回收后服务自己回来，回来时重排一遍闹钟。 -->
        <service
            android:name=".KeepAlive"
            android:exported="false"
            android:stopWithTask="false" />

    </application>
</manifest>
