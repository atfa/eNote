<?xml version="1.0" encoding="utf-8"?>
<!--
  No <uses-sdk> here on purpose: minSdk/targetSdk are passed to `aapt2 link` by build.sh from
  app.env, so the two cannot drift apart.

  Permissions: INTERNET is for the LLM call (and the loopback WebView). The OCR engine is a
  local .so + model files, so images never leave the device.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.xduo.enote"
    android:versionCode="1"
    android:versionName="0.1">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- R13-B：向系统时钟设闹钟（normal 权限，装机即授予）；日历走 ACTION_INSERT，不需要权限 -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- R13-E / P6.5：自研到期提醒，全部标准 API。
         POST_NOTIFICATIONS 是 13+ 的运行时权限；SCHEDULE_EXACT_ALARM 是 31+ 的特殊权限，
         用户可以关掉，关掉后自动降级成 setAndAllowWhileIdle（可能晚几分钟，但不会丢）。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- P11 截图捕获：读媒体库里的图片（MediaStore）。Android 13+ 分权限，12 及以下用旧的那个。 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Optional access for finding eNote backups copied into Download by other apps. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 重启 / 应用升级 / 改时间 / 改时区后重排本地提醒 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- targetSdk 33 上 SCHEDULE_EXACT_ALARM 默认不授予；USE_EXACT_ALARM 是 33+ 给
         闹钟/提醒类应用的自动授予版本，canScheduleExactAlarms() 直接为 true -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- P6.5 常驻后台：前台服务 + 一条低优先级常驻通知，是 AOSP 认可的“别冻结我”信号。
         REQUEST_IGNORE_BATTERY_OPTIMIZATIONS 只用于弹标准的电池优化豁免对话框。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- P16 语音：离线语音识别（本地引擎，不联网）。录音是运行时权限，首次点录音时请求。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:name=".EnoteApp"
        android:label="懒得记"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:debuggable="true">

        <provider
            android:name=".AttachmentProvider"
            android:authorities="dev.xduo.enote.attachments"
            android:exported="false"
            android:grantUriPermissions="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- the share target: 分享 -> 懒得记 -->
        <activity
            android:name=".ShareActivity"
            android:label="懒得记"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Document streams, including PDF, Office and ZIP, create file notes. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- P16 语音：系统其他 App 分享音频进来，本地识别成文字 + 原音频存附件 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <!-- P18：一次分享多段音频 = 一条笔记挂多个附件（与多张图同理） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>
        <!-- 到期闹钟的落点：只发通知，不启动界面（后台唤起 Activity 会被系统拦） -->
        <receiver
            android:name=".Reminders$AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.xduo.enote.REMIND" />
            </intent-filter>
        </receiver>
        <!-- 重启 / 升级 / 改时间 / 改时区：按缓存载荷重排（AlarmManager 重启后清空） -->
        <receiver
            android:name=".Reminders$BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- P6.5 常驻后台（可选，默认关）。targetSdk 33 上不需要 foregroundServiceType；
             START_STICKY 让进程被回收后服务自己回来，回来时重排一遍闹钟。 -->
        <service
            android:name=".KeepAlive"
            android:exported="false"
            android:stopWithTask="false" />

        <service android:name=".OpenAILoginService" android:exported="false" android:stopWithTask="true" />

    </application>
</manifest>
