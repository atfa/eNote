# Read by build.sh / install.sh / test.sh. Anything set in the environment wins over this file.
APP_PACKAGE=dev.xduo.enote
ACTIVITY=MainActivity
APK_NAME=enote.apk
TAG=enote
PLATFORM_API=${PLATFORM_API:-33}
MIN_API=${MIN_API:-26}

# --- Go native layer (see .agents/skills/dev-apk-on-android/references/go-native.md) -----
GO_DIR=go                    # go module with the business logic
GO_LIB=enote                 # -> lib/<abi>/libenote.so  (System.loadLibrary("enote"))
GO_BIN=enotebin              # -> lib/<abi>/libenotebin.so (pure Go helper, unused for now)
GO_LDFLAGS=${GO_LDFLAGS:--s -w}
GO_FLAGS=${GO_FLAGS:-}
